---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halaman tidak ditemukan"
  description="Halaman yang Anda cari tidak tersedia."
>
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow" style="justify-content:center">Error 404</p>
      <h1>404</h1>
      <p class="lede" style="margin-inline:auto; max-width: 34rem">
        Halaman yang Anda cari tidak ditemukan atau sudah dipindahkan.
      </p>
      <p style="margin-top: 1.75rem">
        <a class="btn btn--primary" href="/">Kembali ke beranda</a>
      </p>
    </div>
  </section>
</BaseLayout>
