---
import { site } from "../data/site";

const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "").trim();
const configured = accessKey.length > 0;
---

<div class="contact-form">
  <h2>Kirim pesan</h2>
  <p>
    Sampaikan pertanyaan, usulan, atau informasi kegiatan kepada pengurus
    cabang melalui formulir berikut.
  </p>

  <form
    class="form-grid"
    id="contact-form"
    data-configured={String(configured)}
    novalidate
  >
    <input type="hidden" name="access_key" value={accessKey} />
    <input
      type="hidden"
      name="subject"
      value="Pesan baru dari situs Muhammadiyah Majenang"
    />
    <input type="hidden" name="from_name" value="Situs Muhammadiyah Majenang" />
    <input
      type="checkbox"
      name="botcheck"
      class="visually-hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <div class="form-grid__row">
      <div class="field">
        <label for="name">Nama</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Nama lengkap"
          required
        />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="nama@email.com"
          required
        />
      </div>
    </div>

    <div class="field">
      <label for="phone">
        Nomor telepon <span class="field__hint">(opsional)</span>
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        autocomplete="tel"
        placeholder="+62 812-3456-7890"
      />
    </div>

    <div class="field">
      <label for="message">Pesan</label>
      <textarea
        id="message"
        name="message"
        placeholder="Tulis pesan Anda di sini"
        required></textarea>
    </div>

    <div class="form-actions">
      <button class="btn btn--primary" type="submit">Kirim pesan</button>
      <p
        class="form-status"
        id="contact-status"
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </form>

  <noscript>
    <p class="form-status" data-state="notice">
      Formulir memerlukan JavaScript. Anda dapat menghubungi kami langsung di
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </noscript>
</div>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form) {
    const status = document.getElementById("contact-status");
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const configured = form.dataset.configured === "true";

    const setStatus = (state: string, message: string) => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        setStatus("error", "Mohon lengkapi nama, email, dan pesan.");
        return;
      }

      const key = (
        form.querySelector<HTMLInputElement>('input[name="access_key"]')?.value ?? ""
      ).trim();

      if (!configured || key.length === 0) {
        setStatus(
          "notice",
          "Formulir belum diaktifkan. Silakan hubungi kami melalui email yang tertera pada panel kontak.",
        );
        return;
      }

      if (submit) submit.disabled = true;
      setStatus("pending", "Mengirim pesan...");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        const data = (await response.json()) as {
          success?: boolean;
          message?: string;
        };

        if (response.ok && data.success) {
          form.reset();
          setStatus("success", "Terima kasih, pesan Anda sudah terkirim.");
        } else {
          setStatus(
            "error",
            data.message ?? "Pesan gagal terkirim. Silakan coba lagi.",
          );
        }
      } catch {
        setStatus("error", "Terjadi gangguan jaringan. Silakan coba lagi.");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
