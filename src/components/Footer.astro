---
import { Image } from "astro:assets";
import { site, nav } from "../data/site";
import logoLandscape from "../assets/logo-landscape.png";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div>
      <div class="footer__brand">
        <Image
          class="footer__logo"
          src={logoLandscape}
          alt="Muhammadiyah"
          width={190}
          height={44}
        />
      </div>
      <p>
        Persyarikatan Muhammadiyah bergerak dalam bidang pendidikan, dakwah, dan
        sosial kemasyarakatan. Cabang Majenang berada di Kabupaten Cilacap, Jawa
        Tengah.
      </p>
    </div>

    <div>
      <h2>Navigasi</h2>
      <ul class="footer__links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2>Kontak</h2>
      <ul class="footer__links">
        <li>{site.address.line1}</li>
        <li>{site.address.line2}</li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li>
          <a href={site.social.youtube} target="_blank" rel="noopener noreferrer"
            >YouTube</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>&copy; {year} {site.name}. Hak cipta dilindungi.</span>
    <a class="to-top" href="#main" aria-label="Kembali ke atas halaman">
      Kembali ke atas
    </a>
  </div>
</footer>
