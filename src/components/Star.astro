---
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className = "" } = Astro.props;
---

<svg
  class:list={["star", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="currentColor"
    d="M12 1.5l2.3 6.1 6.2.4-4.9 4 1.6 6.2L12 14.7 6.8 18.2l1.6-6.2-4.9-4 6.2-.4L12 1.5z"></path>
</svg>
